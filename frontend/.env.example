# Copy to .env.local for local overrides, or set in your host's build settings.
#
# Left empty in development: vite.config.ts proxies /api to http://localhost:8080,
# so requests are same-origin and CORS never applies.
#
# In production the frontend and API are deployed separately, so this must point
# at the deployed API, e.g.
#   VITE_API_BASE_URL=https://cyclehaven-api.onrender.com
VITE_API_BASE_URL=
